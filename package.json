{
  "name": "@kazamitte/tech-blog",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.7.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "next build && next-image-export-optimizer",
    "build:packages": "pnpm --filter @kazamitte/markdown-plugin build",
    "dev": "next dev --turbopack",
    "format": "prettier src --write",
    "postbuild": "node scripts/postbuild.mjs",
    "prebuild": "node scripts/prebuild.mjs",
    "predev": "node scripts/prebuild.mjs && next-image-export-optimizer",
    "start": "npx serve dist"
  },
  "dependencies": {
    "@kazamitte/markdown-plugin": "workspace:*",
    "date-fns": "^3.6.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.3",
    "next-image-export-optimizer": "^1.20.1",
    "react": "^19",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@kazamitte/eslint-config": "workspace:*",
    "@kazamitte/textlint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.14.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "^3.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli2": "^0.23.0",
    "postcss": "^8.4.38",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "textlint": "^15.7.1",
    "typescript": "^5.5.2",
    "unified": "^11.0.5"
  }
}
